# Optional official MyAnimeList application client ID.
# Leave empty to use public MAL metadata through Jikan.
# Register an application at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=

# Anikoto metadata API and its matching public website (HTTPS origins only).
ANIKOTO_API_BASE_URL=https://anikotoapi.site
ANIKOTO_SITE_URL=https://anikoto.cz

# Comma-separated exact hostnames permitted for provider-supplied HTTPS embeds.
ANIKOTO_EMBED_HOSTS=megaplay.buzz

# Copy this file to .env.local for local overrides and restart the server.
# Keep credentials server-only: do not use a NEXT_PUBLIC_ prefix.
